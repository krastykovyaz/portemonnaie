# SQLite database file location. Defaults to ./data/app.db if unset.
# DATABASE_PATH="./data/app.db"

# --- Chain mode ---
# DEMO (default if unset) — fully simulated, no network calls, no keys.
# TESTNET — real payment detection against TRON Nile via TronGrid.
# MAINNET — deliberately blocked without CUSTODY_KEY_REF + MAINNET_ACKNOWLEDGED=true.
# CHAIN_MODE="DEMO"

# --- TESTNET payment detection (only used when CHAIN_MODE=TESTNET) ---
# USDT_CONTRACT_ADDRESS="TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf"
# TREASURY_ADDRESS=""

# --- Real TESTNET payout signer (redemptions send real TRC20 USDT on Nile) ---
# Separate opt-in from the payment detection above. Leave PAYOUT_SIGNER unset
# (or anything other than TRON_TESTNET) to keep payouts simulated regardless
# of CHAIN_MODE. Setting it requires ALL of the following to be correct or
# payouts fail closed (MANUAL_REVIEW / FAILED) rather than silently falling
# back to a simulated payout — see src/lib/providers/registry.server.ts.
# PAYOUT_SIGNER="TRON_TESTNET"
# TRON_NETWORK="NILE"
# Testnet-only private key (hex, no 0x prefix) for TREASURY_ADDRESS above.
# NEVER a mainnet key. NEVER commit a real value. This wallet should only
# ever hold Nile testnet TRX/USDT with zero real value.
# CUSTODY_KEY_REF=""

# --- Payout cost accounting / cost guard (see docs/energy-rental.md) ---
# STAKED | RENTED | BURN. Defaults to BURN (treasury burns TRX for any
# Energy/Bandwidth shortfall). Set RENTED to try the Energy rental market
# before burning -- see docs/energy-rental.md for what that actually does on
# Nile today (always the built-in mock, never a real purchase).
# ENERGY_PROVIDER="BURN"
# Rental duration requested from the rental provider when ENERGY_PROVIDER=RENTED.
# One of 1h | 1d | 3d | 7d. Defaults to 1h.
# ENERGY_RENTAL_DURATION="1h"
# Illustrative USD/TRX price used for cost estimates -- no live feed.
# TRX_USD_PRICE="0.15"
# Reject/manual-review a payout whose estimated network cost exceeds this
# many USD, or whose fee minus network cost falls below the configured
# minimum margin. Fail-safe defaults: guard ON, 0 minimum margin, $1 max cost.
# ENABLE_PAYOUT_COST_GUARD="true"
# MIN_PAYOUT_MARGIN_USD="0"
# MAX_NETWORK_COST_USD="1"

# --- Real TRON Energy rental marketplace (Tronex) ---
# MAINNET-ONLY -- see docs/energy-rental.md. Never used while TRON_NETWORK is
# anything other than MAINNET, and this app's own payout gate never allows a
# real signer to activate under MAINNET, so these are effectively inert today
# regardless of whether they're set. Never commit a real value.
# TRONEX_API_KEY=""
# TRONEX_API_URL="https://api.tronex.energy"

# --- Operations / hardening ---
# Bearer token the cron sweep endpoint (POST /api/public/cron/sweep) requires.
# Unset = endpoint disabled (503). The sweep also takes an hourly DB backup.
# CRON_SECRET=""
# Set to true ONLY when running behind a reverse proxy (nginx) so per-IP rate
# limits read X-Forwarded-For. Leave false when clients connect directly —
# trusting the header lets any client choose its own rate-limit bucket.
# TRUST_PROXY="false"
# Deadline for every upstream call (TronGrid, rental marketplace). Default 10000.
# UPSTREAM_TIMEOUT_MS="10000"
# Where hourly/on-demand database snapshots go. Default: <db dir>/backups.
# DB_BACKUP_DIR=""
# The app refuses to start if another live process already holds DATABASE_PATH
# open for writing (e.g. web app + bot on one file) — sql.js rewrites the whole
# file on every write, so two writers silently lose data. Only set this if you
# understand and accept that.
# DATABASE_SHARED_WRITERS="false"
# Disable per-IP rate limiting (local development only).
# RATE_LIMIT_DISABLED="false"

# Encrypts/signs the staff session cookie. Required. Random, >=32 chars, keep
# secret, never commit a real value, don't rotate it casually (it invalidates
# every active session).
SESSION_SECRET=""

# --- Telegram bot (bot/ — separate process, does not affect the web app) ---
# TELEGRAM_BOT_TOKEN=""
# Comma-separated numeric Telegram user ids allowed to run admin commands.
# Get your id from the bot's /whoami command, then add it here.
# TELEGRAM_ADMIN_IDS=""
